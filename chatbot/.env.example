# Copy to a PRIVATE local file and export these variables before running.
# Akash: set values privately in the deployment editor instead.
DATA_DIR=./runtime
CHAT_PASSWORD=REPLACE_WITH_A_PRIVATE_PASSWORD_16_CHARS_OR_LONGER
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
MODEL_THREADS=4
FEED_POLL_SECONDS=300
FEED_FAST_POLL_SECONDS=60
FEED_BACKFILL_DAYS=7
FEED_CORRECTION_DAYS=3
ALERT_TEAMS=NYK
NEWS_FEED_URLS=https://www.rotowire.com/rss/news.php?sport=NBA,https://sny.tv/knicks-feed,https://elitesportsny.com/category/nyc-teams/e-new-york-knicks/feed
INJURY_FEED_URL=
INSTALL_OCR=1

# Free alternatives. Test reachability from your actual provider with /diagnose.
NBA_DATA_SOURCE=manual
NEWS_SOURCE=rss
NEWS_ALERT_SCOPE=league
# One injury digest on Knicks game days; 60 minutes before tipoff (Eastern).
# Live schedule polling uses the persisted published season calendar as a fallback.
NEWS_ALERT_MODE=knicks_gameday
KNICKS_DIGEST_MINUTES_BEFORE=60
KNICKS_SCHEDULE_URL=https://cdn.nba.com/static/json/staticData/scheduleLeagueV2.json
# Existing workbook entities/metrics: previous-day refresh at 11:30 AM Eastern.
# The published data on main updates independently of the pinned application code.
DAILY_NBA_REFRESH=1
NBA_DAILY_DATA_URL=https://raw.githubusercontent.com/allenmirgorodskiyppbot/NBAPPBOT/main/data/live
